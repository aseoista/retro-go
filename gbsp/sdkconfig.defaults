# gbsp-only overrides, applied on top of the target's sdkconfig by rg_tool.py.
# The JIT is ~10% faster with the larger L2 cache (ESP32-P4).
CONFIG_CACHE_L2_CACHE_256KB=y
# Big emulator buffers live in PSRAM BSS (see components/gpsp/gpsp.lf).
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# The JIT runs generated code from PSRAM, which the default PMP setup marks non-executable.
# CONFIG_SPIRAM_PRE_CONFIGURE_MEMORY_PROTECTION is not set
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# Frame pacing sleeps 3-8ms; at 100Hz rg_usleep busy-waits that, starving IDLE0 (task watchdog).
CONFIG_FREERTOS_HZ=1000
